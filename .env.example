# Databricks workspace + service principal (phase 2).
# PGUSER is the service principal CLIENT ID (a UUID), not a username. This trips everyone up once.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Lakebase Autoscaling. ENDPOINT_NAME is the resource path, NOT the host:
#   projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>
ENDPOINT_NAME=
PGHOST=
PGDATABASE=databricks_postgres
PGUSER=
PGPORT=5432
PGSSLMODE=require

# Hyperliquid. No API key, no account, no credit budget - this is the whole config.
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# Collector tuning. See perpdesk/collector/config.py for what each one does.
PERPDESK_TRACKED_WALLETS=1000
PERPDESK_T0_SIZE=10
PERPDESK_T1_SIZE=990
PERPDESK_WEIGHT_BUDGET=1180
PERPDESK_PERIODIC_SNAPSHOT_SEC=900
PERPDESK_REST_CONCURRENCY=6
PERPDESK_CYCLE_SEC=60
# Share of the T2 request budget used to scan never-seen bulk/discovery wallets.
PERPDESK_NEW_ACCOUNT_SHARE=1.0

# App. Set false in Databricks Apps; true makes local UI development self-contained.
PERPDESK_DEMO_MODE=true

# Public demo deployment (Vercel). Both derive from the VERCEL variable that
# Vercel injects, so set them only to override.
#   PERPDESK_READ_ONLY   blocks the two write endpoints and hides their controls.
#                        Defaults true on serverless, false everywhere else.
#   PERPDESK_SERVERLESS  selects the small, self-checking Lakebase pool profile.
# PERPDESK_READ_ONLY=true
# PERPDESK_SERVERLESS=true
